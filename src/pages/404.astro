---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Juan Sabogal">
  <header class="fixed top-0 left-0 right-0 z-50 bg-[#fafafa]/80 backdrop-blur-md">
    <div class="max-w-3xl mx-auto px-6 h-14 flex items-center justify-between">
      <a href="/" class="font-display text-lg font-bold tracking-tight">
        juan<span class="text-[#2563eb]">.</span>sabogal
      </a>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-6 pt-24 pb-16 flex flex-col items-center justify-center min-h-[60vh] text-center">
    <h1 class="font-display text-8xl font-bold text-[#e5e5e5]">404</h1>
    <p class="mt-4 text-lg text-[#666]">Esta página no existe.</p>
    <a href="/" class="mt-8 inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#1a1a1a] text-white text-sm font-medium hover:bg-[#333] transition-colors">
      Volver al inicio →
    </a>
  </main>
</Layout>
